            edge="1" parent="1" source="auth" target="con"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- contract -> execution -->
        <mxCell id="ed2"
            style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=11;labelBackgroundColor=#ffffff;"
            edge="1" parent="1" source="c1" target="e5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="430" y="382"/><mxPoint x="430" y="935"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ed3"
            style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=11;labelBackgroundColor=#ffffff;"
            edge="1" parent="1" source="c2" target="e4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1040" y="382"/><mxPoint x="1040" y="520"/><mxPoint x="930" y="520"/><mxPoint x="930" y="874"/></Array>
          </mxGeometry>
        </mxCell>

        <!-- main vertical pipeline -->
        <mxCell id="ed5" value="SPSC ring — thread boundary"
            style="endArrow=block;html=1;rounded=0;strokeWidth=3;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;fontStyle=1;fontColor=#b85450;labelBackgroundColor=#ffffff;"
            edge="1" parent="1" source="e3" target="e3b">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-27"/></mxGeometry>
        </mxCell>
        <mxCell id="ed6" value="closed bars"
