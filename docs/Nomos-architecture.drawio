            edge="1" parent="1" source="e3b" target="e4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed7" value="indicator values"
            style="endArrow=block;html=1;rounded=0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;labelBackgroundColor=#ffffff;"
            edge="1" parent="1" source="e4" target="e5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed8" value="intents (symbol · side · conviction)"
            style="endArrow=block;html=1;rounded=0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;labelBackgroundColor=#ffffff;"
