            edge="1" parent="1" source="e6" target="jr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed9" value="encode + socket write (on T2)"
            style="endArrow=block;html=1;rounded=0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;labelBackgroundColor=#ffffff;"
            edge="1" parent="1" source="jr" target="e7">
