          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="0" y="-14"/></mxGeometry>
        </mxCell>

        <!-- status back to Python -->
        <mxCell id="ed20" value="GET /status /pnl /positions&#10;SSE /events  ·  POST control"
