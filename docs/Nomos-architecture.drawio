        </mxCell>
        <mxCell id="ed10"
            style="endArrow=block;html=1;rounded=0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
            edge="1" parent="1" source="e7" target="e8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ed11" value="orders out"
            style="endArrow=block;html=1;rounded=0;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=11;labelBackgroundColor=#ffffff;"
            edge="1" parent="1" source="e8" target="ext"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- market-data return path up the far left -->
        <mxCell id="ed4" value="market data in&#10;(quotes / trades)"
            style="endArrow=block;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeWidth=2;strokeColor=#2d7600;exitX=0;exitY=0.5;entryX=0;entryY=0.85;fontSize=11;fontColor=#2d7600;labelBackgroundColor=#ffffff;"
            edge="1" parent="1" source="e8" target="e3">
          <mxGeometry relative="1" as="geometry">
